{
  "plots": [
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "throughput",
      "y_lbl": "Task attach/fork attempts per second",
      "hue": "execution_unit",
      "hue_lbl": "Execution unit",
      "shape": "lineplot",
      "title": "cgroup v2 pids limit throughput vs. #Containers"
    }
  ],
  "benchmark_config": {
    "duration": 10,
    "repeat": 1,
    "exec_env": [
      "container"
    ],
    "initial_size": [
      32
    ],
    "noise": [
      0
    ],
    "threads": {
      "values": [
        [
          8
        ]
      ]
    },
    "monitors": {
      "mpstat": [
        "-n",
        "-u",
        "-I",
        "SCPU,SUM",
        "-P",
        "ALL"
      ],
      "perf": [
        "-a"
      ]
    }
  },
  "containers": {
    "container_list": {
      "values": [
        [
          1
        ],
        {
          "min": 8,
          "step": 8,
          "max": 128
        }
      ]
    },
    "core_count": 1
  },
  "applications": [
    {
      "path": "bm-external/cgroupv2-stress",
      "name": "cgv2_limits_pids.sh",
      "args": "-d {duration} -t {threads} -s {initial_size} -n {noise} -i {index}"
    }
  ]
}
