From 3bfeba84b1b539e0c0c862821a2c0f64d83a0a69 Mon Sep 17 00:00:00 2001
From: Martin Beck <martin.beck2@gmx.de>
Date: Mon, 8 Jun 2026 15:09:54 +0200
Subject: [PATCH 1/2] ext4: optionally batch concurrent fsync flushes

The bm_min_rocks_fcntl_pread64_0_0 workload issues many
concurrent fdatasync calls after small buffered writes. Once ext4 has
waited for data writeback and the relevant journal transaction, the
final device cache flush can become the storage-side scalability
limiter.

Add an opt-in fsync_batch_usec mount option. A non-zero value opens a
short collection window before submitting a required device flush.
Callers that have already completed their writeback and journal
prerequisites before the flush is submitted can share that flush.
Callers arriving after submission wait for the current flush and then
start a new batch.

The option defaults to zero, preserving existing behavior unless a
workload explicitly trades bounded fsync latency for fewer flush
commands.

Signed-off-by: Martin Beck <martin.beck2@gmx.de>
---
 fs/ext4/ext4.h  |  9 +++++++
 fs/ext4/fsync.c | 66 ++++++++++++++++++++++++++++++++++++++++++++++++-
 fs/ext4/super.c | 24 ++++++++++++++++++
 3 files changed, 98 insertions(+), 1 deletion(-)

diff --git a/fs/ext4/ext4.h b/fs/ext4/ext4.h
index c9d79998cf09..749428a6a916 100644
--- a/fs/ext4/ext4.h
+++ b/fs/ext4/ext4.h
@@ -1571,6 +1571,15 @@ struct ext4_sb_info {
 	unsigned long s_commit_interval;
 	u32 s_max_batch_time;
 	u32 s_min_batch_time;
+	u32 s_fsync_batch_usec;
+
+	/* Protects opt-in batching of concurrent fsync device flushes. */
+	struct mutex s_fsync_flush_lock;
+	wait_queue_head_t s_fsync_flush_wait;
+	bool s_fsync_flush_running;
+	bool s_fsync_flush_collecting;
+	int s_fsync_flush_error;
+	unsigned long s_fsync_flush_seq;
 	struct bdev_handle *s_journal_bdev_handle;
 #ifdef CONFIG_QUOTA
 	/* Names of quota files with journalled quota */
diff --git a/fs/ext4/fsync.c b/fs/ext4/fsync.c
index ca9d6aaa88a7..2e8b7b4385da 100644
--- a/fs/ext4/fsync.c
+++ b/fs/ext4/fsync.c
@@ -29,6 +29,7 @@
 #include <linux/writeback.h>
 #include <linux/blkdev.h>
 #include <linux/buffer_head.h>
+#include <linux/delay.h>
 
 #include "ext4.h"
 #include "ext4_jbd2.h"
@@ -127,6 +128,69 @@ static int ext4_fsync_journal(struct inode *inode, bool datasync,
 	return ext4_fc_commit(journal, commit_tid);
 }
 
+static int ext4_issue_fsync_flush(struct super_block *sb)
+{
+	struct ext4_sb_info *sbi = EXT4_SB(sb);
+	u32 batch_usec = READ_ONCE(sbi->s_fsync_batch_usec);
+	unsigned long seq;
+	int ret;
+
+	if (!batch_usec)
+		return blkdev_issue_flush(sb->s_bdev);
+
+again:
+	mutex_lock(&sbi->s_fsync_flush_lock);
+	if (sbi->s_fsync_flush_collecting) {
+		/*
+		 * This caller has completed writeback and journal commit before
+		 * joining the batch, and the leader has not submitted the flush
+		 * yet.  Waiting for that flush preserves fdatasync ordering.
+		 */
+		seq = sbi->s_fsync_flush_seq;
+		mutex_unlock(&sbi->s_fsync_flush_lock);
+		wait_event(sbi->s_fsync_flush_wait,
+			   READ_ONCE(sbi->s_fsync_flush_seq) != seq);
+		mutex_lock(&sbi->s_fsync_flush_lock);
+		ret = sbi->s_fsync_flush_error;
+		mutex_unlock(&sbi->s_fsync_flush_lock);
+		return ret;
+	}
+
+	if (sbi->s_fsync_flush_running) {
+		/*
+		 * The flush has already been submitted, so this caller's data
+		 * may be newer than that flush.  Wait and start a new batch.
+		 */
+		seq = sbi->s_fsync_flush_seq;
+		mutex_unlock(&sbi->s_fsync_flush_lock);
+		wait_event(sbi->s_fsync_flush_wait,
+			   READ_ONCE(sbi->s_fsync_flush_seq) != seq);
+		goto again;
+	}
+
+	sbi->s_fsync_flush_running = true;
+	sbi->s_fsync_flush_collecting = true;
+	sbi->s_fsync_flush_seq++;
+	mutex_unlock(&sbi->s_fsync_flush_lock);
+
+	usleep_range(batch_usec, batch_usec + min_t(u32, batch_usec, 1000));
+
+	mutex_lock(&sbi->s_fsync_flush_lock);
+	sbi->s_fsync_flush_collecting = false;
+	mutex_unlock(&sbi->s_fsync_flush_lock);
+
+	ret = blkdev_issue_flush(sb->s_bdev);
+
+	mutex_lock(&sbi->s_fsync_flush_lock);
+	sbi->s_fsync_flush_error = ret;
+	sbi->s_fsync_flush_running = false;
+	sbi->s_fsync_flush_seq++;
+	mutex_unlock(&sbi->s_fsync_flush_lock);
+	wake_up_all(&sbi->s_fsync_flush_wait);
+
+	return ret;
+}
+
 /*
  * akpm: A new design for ext4_sync_file().
  *
@@ -181,7 +245,7 @@ int ext4_sync_file(struct file *file, loff_t start, loff_t end, int datasync)
 
 issue_flush:
 	if (needs_barrier) {
-		err = blkdev_issue_flush(inode->i_sb->s_bdev);
+		err = ext4_issue_fsync_flush(inode->i_sb);
 		if (!ret)
 			ret = err;
 	}
diff --git a/fs/ext4/super.c b/fs/ext4/super.c
index 35198cc30812..d9dd7ea8d9f3 100644
--- a/fs/ext4/super.c
+++ b/fs/ext4/super.c
@@ -1761,6 +1761,7 @@ enum {
 	Opt_max_dir_size_kb, Opt_nojournal_checksum, Opt_nombcache,
 	Opt_no_prefetch_block_bitmaps, Opt_mb_optimize_scan,
 	Opt_buffered_iomap, Opt_nobuffered_iomap,
+	Opt_fsync_batch_usec,
 	Opt_errors, Opt_data, Opt_data_err, Opt_jqfmt, Opt_dax_type,
 #ifdef CONFIG_EXT4_DEBUG
 	Opt_fc_debug_max_replay, Opt_fc_debug_force
@@ -1905,6 +1906,7 @@ static const struct fs_parameter_spec ext4_param_specs[] = {
 	fsparam_s32	("mb_optimize_scan",	Opt_mb_optimize_scan),
 	fsparam_flag	("buffered_iomap",	Opt_buffered_iomap),
 	fsparam_flag	("nobuffered_iomap",	Opt_nobuffered_iomap),
+	fsparam_u32	("fsync_batch_usec",	Opt_fsync_batch_usec),
 	fsparam_string	("check",		Opt_removed),	/* mount option from ext2/3 */
 	fsparam_flag	("nocheck",		Opt_removed),	/* mount option from ext2/3 */
 	fsparam_flag	("reservation",		Opt_removed),	/* mount option from ext2/3 */
@@ -2053,6 +2055,8 @@ ext4_sb_read_encoding(const struct ext4_super_block *es)
 #define EXT4_SPEC_s_fc_debug_max_replay		(1 << 17)
 #define EXT4_SPEC_s_sb_block			(1 << 18)
 #define EXT4_SPEC_mb_optimize_scan		(1 << 19)
+#define EXT4_SPEC_s_fsync_batch_usec		BIT(20)
+#define EXT4_MAX_FSYNC_BATCH_USEC		10000
 
 struct ext4_fs_context {
 	char		*s_qf_names[EXT4_MAXQUOTAS];
@@ -2080,6 +2084,7 @@ struct ext4_fs_context {
 	unsigned int	spec;
 	u32		s_max_batch_time;
 	u32		s_min_batch_time;
+	u32		s_fsync_batch_usec;
 	kuid_t		s_resuid;
 	kgid_t		s_resgid;
 	ext4_fsblk_t	s_sb_block;
@@ -2344,6 +2349,16 @@ static int ext4_parse_param(struct fs_context *fc, struct fs_parameter *param)
 		ctx->s_min_batch_time = result.uint_32;
 		ctx->spec |= EXT4_SPEC_s_min_batch_time;
 		return 0;
+	case Opt_fsync_batch_usec:
+		if (result.uint_32 > EXT4_MAX_FSYNC_BATCH_USEC) {
+			ext4_msg(NULL, KERN_ERR,
+				 "Invalid fsync_batch_usec %u, must be <= %u",
+				 result.uint_32, EXT4_MAX_FSYNC_BATCH_USEC);
+			return -EINVAL;
+		}
+		ctx->s_fsync_batch_usec = result.uint_32;
+		ctx->spec |= EXT4_SPEC_s_fsync_batch_usec;
+		return 0;
 	case Opt_inode_readahead_blks:
 		if (result.uint_32 &&
 		    (result.uint_32 > (1 << 30) ||
@@ -2954,6 +2969,7 @@ static void ext4_apply_options(struct fs_context *fc, struct super_block *sb)
 	APPLY(s_stripe);
 	APPLY(s_max_batch_time);
 	APPLY(s_min_batch_time);
+	APPLY(s_fsync_batch_usec);
 	APPLY(s_want_extra_isize);
 	APPLY(s_inode_readahead_blks);
 	APPLY(s_max_dir_size_kb);
@@ -3110,6 +3126,8 @@ static int _ext4_show_options(struct seq_file *seq, struct super_block *sb,
 		SEQ_OPTS_PRINT("min_batch_time=%u", sbi->s_min_batch_time);
 	if (nodefs || sbi->s_max_batch_time != EXT4_DEF_MAX_BATCH_TIME)
 		SEQ_OPTS_PRINT("max_batch_time=%u", sbi->s_max_batch_time);
+	if (nodefs || sbi->s_fsync_batch_usec)
+		SEQ_OPTS_PRINT("fsync_batch_usec=%u", sbi->s_fsync_batch_usec);
 	if (nodefs || sbi->s_stripe)
 		SEQ_OPTS_PRINT("stripe=%lu", sbi->s_stripe);
 	if (nodefs || EXT4_MOUNT_DATA_FLAGS &
@@ -4444,6 +4462,9 @@ static struct ext4_sb_info *ext4_alloc_sbi(struct super_block *sb)
 	if (!sbi->s_blockgroup_lock)
 		goto err_out;
 
+	mutex_init(&sbi->s_fsync_flush_lock);
+	init_waitqueue_head(&sbi->s_fsync_flush_wait);
+
 	sb->s_fs_info = sbi;
 	sbi->s_sb = sb;
 	return sbi;
@@ -6602,6 +6623,7 @@ struct ext4_mount_options {
 	kgid_t s_resgid;
 	unsigned long s_commit_interval;
 	u32 s_min_batch_time, s_max_batch_time;
+	u32 s_fsync_batch_usec;
 #ifdef CONFIG_QUOTA
 	int s_jquota_fmt;
 	char *s_qf_names[EXT4_MAXQUOTAS];
@@ -6634,6 +6656,7 @@ static int __ext4_remount(struct fs_context *fc, struct super_block *sb)
 	old_opts.s_commit_interval = sbi->s_commit_interval;
 	old_opts.s_min_batch_time = sbi->s_min_batch_time;
 	old_opts.s_max_batch_time = sbi->s_max_batch_time;
+	old_opts.s_fsync_batch_usec = sbi->s_fsync_batch_usec;
 #ifdef CONFIG_QUOTA
 	old_opts.s_jquota_fmt = sbi->s_jquota_fmt;
 	for (i = 0; i < EXT4_MAXQUOTAS; i++)
@@ -6909,6 +6932,7 @@ static int __ext4_remount(struct fs_context *fc, struct super_block *sb)
 	sbi->s_commit_interval = old_opts.s_commit_interval;
 	sbi->s_min_batch_time = old_opts.s_min_batch_time;
 	sbi->s_max_batch_time = old_opts.s_max_batch_time;
+	sbi->s_fsync_batch_usec = old_opts.s_fsync_batch_usec;
 	ext4_writepages_up_write(sb, alloc_ctx);
 
 	if (!test_opt(sb, BLOCK_VALIDITY) && sbi->s_system_blks)
-- 
